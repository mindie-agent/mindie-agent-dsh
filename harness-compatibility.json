{
  "schema": "mindie-harness-compatibility/1",
  "harness": "DeepSeek Harness (dsh)",
  "adapter": "mindie-agent-dsh",
  "plugin_version": "0.0.3",
  "verified": [
    {
      "dsh_version": "0.2.0-rc.2",
      "node": ">=22",
      "python": ">=3.11",
      "platforms": [
        "macOS 27.0.1 arm64",
        "Ubuntu 24.04 WSL (4090)",
        "Windows 11 native (Lenovo)"
      ],
      "evidence": "docs/verification.md"
    }
  ],
  "interfaces": [
    {
      "id": "bundle-patch",
      "contract": "package.json dsh.bundle.patch -> cordis.patch.yml insert rows",
      "used_by": "cordis.patch.yml"
    },
    {
      "id": "skill-filesystem",
      "package": "@deepseek-ai/dsh-skill-filesystem",
      "contract": "customSkillDirs + providerName",
      "used_by": "cordis.patch.yml"
    },
    {
      "id": "mcp-stdio",
      "package": "@deepseek-ai/dsh-mcp-client",
      "contract": "stdio command/args/env/cwd, toolCallTimeoutMs, failOnStartupError",
      "used_by": "cordis.patch.yml"
    },
    {
      "id": "host-tools",
      "package": "ctx.tools.register",
      "contract": "registered tool definitions with parameters/output/execute",
      "used_by": "host3.mjs"
    },
    {
      "id": "agent-turn-stopping",
      "package": "ctx.on('agent/turn-stopping')",
      "contract": "agent, turn, signal; session id and header cwd",
      "used_by": "host3.mjs"
    },
    {
      "id": "agent-route",
      "package": "exec.agent.options",
      "contract": "provider/model route for the session's DSH model",
      "used_by": "host3.mjs"
    },
    {
      "id": "llm-stream",
      "package": "ctx.llm.stream",
      "contract": "text-delta, usage and finish chunks for the summary endpoint",
      "used_by": "host3.mjs"
    },
    {
      "id": "session-v4-transcript",
      "contract": "~/.dsh/sessions/*/session-*/session.v4.jsonl.zstd concatenated zstd frames",
      "used_by": "scripts/dsh_transcript.py"
    },
    {
      "id": "cordis-child-plugin",
      "package": "ctx.plugin",
      "contract": "stable launcher mounts an immutable generation as a child Cordis plugin and disposes it on swap",
      "used_by": "host.mjs"
    },
    {
      "id": "generation-pointer",
      "contract": "update/current.json atomic pointer to a verified generation package",
      "used_by": "host.mjs, scripts/updater.py"
    },
    {
      "id": "github-release-api",
      "contract": "formal releases only; SHA256SUMS; bounded asset download",
      "used_by": "scripts/updater.py"
    },
    {
      "id": "uv-runtime",
      "contract": "uv run --no-project --python 3.11 and uv sync --frozen --project",
      "used_by": "cordis.patch.yml, scripts/setup.py"
    },
    {
      "id": "mindie-bench-headless",
      "contract": "mindie-bench native dsh harness: dsh --profile bench --json, pi-ai OpenAI Responses route, fresh DSH_HOME, MCP/skill rows; G0-G2",
      "used_by": "../mindie-bench"
    }
  ],
  "notes": [
    "Only stable DSH packages are named; no @deepseek-ai/dsh-experimental-* package is used.",
    "The bundle inserts Host rows and overrides no shipped row or shipped preset."
  ]
}
